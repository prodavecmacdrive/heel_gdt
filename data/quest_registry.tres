flag_id = "door_01_unlocked"
default_value = false
category = "Door"
description = "Флаг снятия блокировки с шлюза door_01."

[resource]
script = ExtResource("1_qreg")
items = Array[ExtResource("2_item")]([SubResource("Resource_item_key"), SubResource("Resource_item_battery"), SubResource("Resource_item_note"), SubResource("Resource_item_screwdriver"), SubResource("Resource_item_card")])
flags = Array[ExtResource("3_flag")]([SubResource("Resource_flag_room01_key"), SubResource("Resource_flag_terminal_door01"), SubResource("Resource_flag_chest01"), SubResource("Resource_flag_chest02"), SubResource("Resource_flag_door01")])
registered_object_ids = PackedStringArray("room_01_key", "room_01_chest", "terminal_door_01", "room_02_chest")

