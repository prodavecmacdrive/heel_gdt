[sub_resource type="Resource" id="Resource_flag_room01_key"]
script = ExtResource("3_flag")
flag_id = "room_01_key"
default_value = false
category = "Item State"
description = "Флаг подбора предмета 'Ключ' с пола в комнате room_01."

[sub_resource type="Resource" id="Resource_flag_terminal_door01"]
script = ExtResource("3_flag")
flag_id = "terminal_door_01"
default_value = false
category = "Puzzle"
description = "Флаг успешной разблокировки терминала шлюза в комнате room_01."

[sub_resource type="Resource" id="Resource_flag_chest01"]
script = ExtResource("3_flag")
flag_id = "room_01_chest_unlocked"
default_value = false
category = "Puzzle"
description = "Флаг отпирания контейнера хранения в комнате room_01."

[sub_resource type="Resource" id="Resource_flag_chest02"]
script = ExtResource("3_flag")
flag_id = "room_02_chest_unlocked"
default_value = false
category = "Puzzle"
description = "Флаг отпирания контейнера хранения в комнате room_02."

[sub_resource type="Resource" id="Resource_flag_door01"]
