[gd_resource type="Resource" script_class="QuestRegistryData" load_steps=14 format=3]

[ext_resource type="Script" path="res://core/registry/quest_registry_data.gd" id="1_qreg"]
[ext_resource type="Script" path="res://core/item_data.gd" id="2_item"]
[ext_resource type="Script" path="res://core/registry/world_flag_data.gd" id="3_flag"]

[sub_resource type="Resource" id="Resource_item_key"]
script = ExtResource("2_item")
item_id = "Ключ"
item_name = "Ключ"
category = "Key"
color = Color(1, 0.85, 0.2, 1)
description = "Стандартный ключ доступа сектора 01. Открывает запертый контейнер и электронный терминал шлюза."
metadata = {}

[sub_resource type="Resource" id="Resource_item_battery"]
script = ExtResource("2_item")
item_id = "Батарейка"
item_name = "Батарейка"
category = "Tool"
color = Color(0.3, 0.85, 0.5, 1)
description = "Энергетический элемент питания для портативных приборов и резервных цепей."
metadata = {}

[sub_resource type="Resource" id="Resource_item_note"]
script = ExtResource("2_item")
